{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zovark.io/replay_record/v1.0.0/schema.json",
  "title": "Replay Record",
  "description": "Tape-recorder envelope over an investigation. Captures every LLM I/O exchange, tool call, and verdict input so re-execution is byte-identical without re-invoking the LLM. Per ADR-0020 / ADR-0026.",
  "type": "object",
  "x-zovark-schema-version": "1.0.0",
  "x-zovark-compatibility": "backward",
  "x-zovark-license": "Apache-2.0",
  "x-zovark-owner": "platform-owner",
  "x-zovark-visibility": "internal",
  "x-zovark-standards-attribution": [
    {
      "standard": "JSON-Schema-2020-12",
      "version": "2020-12",
      "role": "canonical",
      "license": "BSD-3-Clause",
      "source": "https://json-schema.org/draft/2020-12/schema"
    },
    {
      "standard": "OCSF-1.1",
      "version": "1.1",
      "role": "referenced",
      "license": "Apache-2.0",
      "source": "https://schema.ocsf.io/"
    }
  ],
  "x-zovark-breaking-change-requires-adr": true,
  "additionalProperties": false,
  "required": [
    "replay_id",
    "tenant_id",
    "investigation_id",
    "schema_version",
    "tool_catalog_version",
    "model_descriptor",
    "policy_snapshot_version",
    "threshold_version",
    "exchanges",
    "verdict_id"
  ],
  "properties": {
    "replay_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "investigation_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tool_catalog_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Frozen historical catalog (INV-010)."
    },
    "model_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "version",
        "deterministic_seed"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "deterministic_seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "policy_snapshot_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "threshold_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "exchanges": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "description": "Ordered LLM I/O and tool-call records.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exchange_seq",
          "kind"
        ],
        "properties": {
          "exchange_seq": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "llm_request",
              "llm_response",
              "tool_call",
              "tool_result"
            ]
          },
          "canonical_payload": {
            "type": "string",
            "description": "RFC 8785 JCS canonical JSON."
          },
          "payload_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "verdict_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
